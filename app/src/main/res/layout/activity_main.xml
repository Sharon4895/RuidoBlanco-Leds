<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Soothing meditation-themed icon layout wrapper -->
        <FrameLayout
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:background="@android:drawable/dialog_holo_light_frame"
            android:backgroundTint="#E0F2F1"
            android:layout_marginBottom="24dp">
            
            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_menu_compass"
                android:contentDescription="Compass Icon"
                app:tint="#009688"/>
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Relax App"
            android:textSize="32sp"
            android:textColor="#0F172A"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Control de Ruido Blanco &amp; LEDs"
            android:textSize="15sp"
            android:textColor="#64748B"
            android:layout_marginBottom="36dp"/>

        <!-- Inputs Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <EditText
                    android:id="@+id/etUsuario"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:hint="Alias del usuario"
                    android:inputType="textPersonName"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/bg_input"
                    android:textColor="#1E293B"
                    android:textColorHint="#94A3B8"
                    android:textSize="16sp"
                    android:layout_marginBottom="16dp"
                    android:minHeight="48dp" />

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:hint="Contraseña"
                    android:inputType="textPassword"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/bg_input"
                    android:textColor="#1E293B"
                    android:textColorHint="#94A3B8"
                    android:textSize="16sp"
                    android:minHeight="48dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="INICIAR SESIÓN"
            android:backgroundTint="#009688"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="16sp"
            android:letterSpacing="0.05"
            app:cornerRadius="16dp"
            android:elevation="4dp"/>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
