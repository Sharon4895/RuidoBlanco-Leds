<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:layout_marginTop="40dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Panel de Control"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#0F172A"
            android:layout_marginBottom="16dp"/>

        <!-- CARD 1: Bluetooth Connection -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvEstado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Estado: Desconectado"
                    android:textAlignment="center"
                    android:textColor="#EF4444"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:layout_marginBottom="12dp"/>

                <Button
                    android:id="@+id/btnBT"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="CONECTAR DISPOSITIVO ESP32"
                    android:backgroundTint="#3F51B5"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- CARD 2: Realtime Visualization & Program Select -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Visualización de Señal (LEDs)"
                    android:textStyle="bold"
                    android:textColor="#334155"
                    android:textSize="15sp"
                    android:layout_marginBottom="8dp"/>

                <com.example.myapplication.VistaGrafica
                    android:id="@+id/viewGrafica"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:background="#0F172A"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:id="@+id/tvProgramaActual"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Programa: A2"
                    android:textAlignment="center"
                    android:textSize="15sp"
                    android:textColor="#475569"
                    android:textStyle="italic"
                    android:layout_marginBottom="8dp"/>

                <SeekBar
                    android:id="@+id/sbTiempo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Programa Seleccionado:"
                    android:textStyle="bold"
                    android:textColor="#334155"
                    android:layout_marginBottom="6dp"/>

                <Spinner
                    android:id="@+id/spinnerProgramas"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@android:drawable/btn_dropdown"
                    android:spinnerMode="dropdown"
                    android:layout_marginBottom="4dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- CARD 3: Exec Controls -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp">

                <Button
                    android:id="@+id/btnPlayPause"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="EJECUTAR"
                    android:backgroundTint="#10B981"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    android:layout_marginEnd="6dp"/>

                <Button
                    android:id="@+id/btnStop"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="DETENER"
                    android:backgroundTint="#EF4444"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    android:layout_marginStart="6dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- CARD 4: Sound Settings -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Volumen de Ruido:"
                    android:textStyle="bold"
                    android:textColor="#334155"
                    android:layout_marginBottom="6dp"/>

                <SeekBar
                    android:id="@+id/sbVolumen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="50"
                    android:layout_marginBottom="16dp"/>

                <Button
                    android:id="@+id/btnRuidoTono"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="Modo: Ruido Blanco"
                    android:backgroundTint="#8B5CF6"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ajuste de Pitch"
                    android:textAlignment="center"
                    android:textStyle="bold"
                    android:textColor="#334155"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <Button
                        android:id="@+id/btnPitchDown"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="PITCH -"
                        android:backgroundTint="#64748B"
                        app:cornerRadius="12dp"
                        android:layout_marginEnd="6dp"/>

                    <Button
                        android:id="@+id/btnPitchUp"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="PITCH +"
                        android:backgroundTint="#64748B"
                        app:cornerRadius="12dp"
                        android:layout_marginStart="6dp"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- CARD 5: Relaxation Canvas Launcher -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <Button
                    android:id="@+id/btnVerImagen"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="VER CANVAS DE RELAJACIÓN"
                    android:backgroundTint="#0D9488"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>