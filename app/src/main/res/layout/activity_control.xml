<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:layout_marginTop="40dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Estado: Desconectado"
            android:textAlignment="center"
            android:textColor="#FF0000"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnBT"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CONECTAR BLUETOOTH"
            android:backgroundTint="#3F51B5"
            android:textColor="@android:color/white"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC"
            android:layout_marginVertical="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sincronía en Tiempo Real:"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <com.example.myapplication.VistaGrafica
            android:id="@+id/viewGrafica"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:background="#000000" />

        <TextView
            android:id="@+id/tvProgramaActual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Programa: A2"
            android:textAlignment="center"
            android:textStyle="italic"
            android:layout_marginTop="12dp"/>

        <SeekBar
            android:id="@+id/sbTiempo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="8dp" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:alignmentMode="alignMargins"
            android:layout_marginTop="8dp">

            <Button android:id="@+id/btnA2" android:text="A2" android:layout_columnWeight="1" />
            <Button android:id="@+id/btnA3" android:text="A3" android:layout_columnWeight="1" />
            <Button android:id="@+id/btnB4" android:text="B4" android:layout_columnWeight="1" />
            <Button android:id="@+id/btnAB1" android:text="AB1" android:layout_columnWeight="1" />
            <Button android:id="@+id/btnAB5" android:text="AB5" android:layout_columnWeight="1" />
            <Button android:id="@+id/btnAB6" android:text="AB6" android:layout_columnWeight="1" />
        </GridLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <Button
                android:id="@+id/btnPlayPause"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="EJECUTAR"
                android:backgroundTint="#4CAF50"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btnStop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="PARAR"
                android:backgroundTint="#F44336"
                android:layout_marginStart="4dp"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Volumen de Ruido:"
            android:layout_marginTop="16dp"/>

        <SeekBar
            android:id="@+id/sbVolumen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="50"/>

        <Button
            android:id="@+id/btnRuidoTono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Modo: Ruido Blanco"
            android:layout_marginTop="12dp"
            android:backgroundTint="#9C27B0"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ajuste de Pitch"
            android:textAlignment="center"
            android:layout_marginTop="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btnPitchDown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PITCH -"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnPitchUp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PITCH +"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>