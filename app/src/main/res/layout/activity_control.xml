<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Estado: Desconectado"
            android:textAlignment="center"
            android:textColor="#FF0000"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/btnBT"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Conectar con ESP32"
            android:backgroundTint="#3F51B5"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sincronía (Onda Diente de Sierra):"
            android:layout_marginTop="20dp"
            android:textStyle="bold"/>

        <com.example.myapplication.VistaGrafica
            android:id="@+id/viewGrafica"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginVertical="10dp"
            android:background="#111111" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Seleccionar Programa:"
            android:textStyle="bold"
            android:layout_marginTop="10dp"/>

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:alignmentMode="alignMargins"
            android:layout_gravity="center">

            <Button android:id="@+id/btnA2" android:text="A2" android:layout_columnWeight="1" />
            <Button android:id="@+id/btnA3" android:text="A3" android:layout_columnWeight="1" />
            <Button android:id="@+id/btnB4" android:text="B4" android:layout_columnWeight="1" />
            <Button android:id="@+id/btnAB1" android:text="AB1" android:layout_columnWeight="1" />
            <Button android:id="@+id/btnAB5" android:text="AB5" android:layout_columnWeight="1" />
            <Button android:id="@+id/btnAB6" android:text="AB6" android:layout_columnWeight="1" />
        </GridLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="20dp"
            android:background="@android:color/white"
            android:padding="10dp"
            android:elevation="2dp">

            <Button
                android:id="@+id/btnPlayPause"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="EJECUTAR PROGRAMA"
                android:backgroundTint="#4CAF50"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nivel de Volumen (Ruido Blanco):"
                android:layout_marginTop="10dp"/>
            <SeekBar
                android:id="@+id/sbVolumen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="50"/>

            <Button
                android:id="@+id/btnRuidoTono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Modo: Ruido Blanco"
                android:layout_marginTop="10dp"
                android:backgroundTint="#9C27B0"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ajuste de Pitch (Tono)"
                android:textAlignment="center"
                android:layout_marginTop="10dp"
                android:textStyle="italic"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/btnPitchDown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▼ Bajar"
                    android:layout_marginEnd="10dp"/>

                <Button
                    android:id="@+id/btnPitchUp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▲ Subir" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Progreso del Programa (0 - 30 min)"
                android:textAlignment="center"
                android:layout_marginTop="10dp"/>

            <SeekBar
                android:id="@+id/sbTiempo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="30"
                android:progress="0" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>