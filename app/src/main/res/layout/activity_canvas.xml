<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F8FAFC">

    <TextView
        android:id="@+id/tvInstrucciones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Meditación &amp; Arte Generativo"
        android:textSize="22sp"
        android:textColor="#0F172A"
        android:textStyle="bold"
        android:textAlignment="center"
        android:layout_marginTop="28dp"
        android:layout_marginBottom="6dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Inclina tu celular para interactuar en 3D"
        android:textSize="14sp"
        android:textColor="#64748B"
        android:textAlignment="center"
        android:layout_marginBottom="20dp"/>

    <Button
        android:id="@+id/btnIniciarServicio"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="INICIAR SERVICIO CANVAS"
        android:backgroundTint="#3F51B5"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        app:cornerRadius="14dp"
        android:layout_marginBottom="20dp" />

    <!-- Floating card window for the canvas animation -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:cardCornerRadius="24dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="#EEEEEE"
        android:layout_marginBottom="12dp">

        <com.example.myapplication.MiCanvasView
            android:id="@+id/miCanvas"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
            
    </androidx.cardview.widget.CardView>

</LinearLayout>
